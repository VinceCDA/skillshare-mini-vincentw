{% extends 'base.html.twig' %}

{% block title %}Hello ProfileController!
{% endblock %}

{% block body %}
	<h1>Edit
		{{userData.name}}</h1>
	{{ form_start(form) }}
	{{ form_widget(form) }}
	<button class="btn">{{ button_label|default('Save') }}</button>
	{{ form_end(form) }}
	{% for skill in skills %}
		<tr>
			<td>{{ skill.id }}</td>
			<td>{{ skill.label }}</td>
			<td>
				<a href="{{ path('app_profile_skillofferedadd', {'id': skill.id}) }}">ADD</a>
				<a href="{{ path('app_profile_skillwantedadd', {'id': skill.id}) }}">ADD</a>
				<a href="{{ path('app_skill_edit', {'id': skill.id}) }}">edit</a>
			</td>
		</tr>
	{% else %}
		<tr>
			<td colspan="4">no records found</td>
		</tr>
	{% endfor %}
	{% for skillOffered in userData.userSkillOffereds %}
		<tr>
			<td>{{ skillOffered.skill.label }}</td>
			<td>
				<a href="{{ path('app_profile_skilloffereddel', {'id': skillOffered.id}) }}">DELETE</a>
			</td>
		</tr>
	{% else %}
		<tr>
			<td colspan="4">no records found</td>
		</tr>
	{% endfor %}
	{% for skillWanted in userData.userSkillWanteds %}
		<tr>
			<td>{{ skillWanted.skill.label }}</td>
			<td>
				<a href="{{ path('app_profile_skillwanteddel', {'id': skillWanted.id}) }}">DELETE</a>
			</td>
		</tr>
	{% else %}
		<tr>
			<td colspan="4">no records found</td>
		</tr>
	{% endfor %}
{% endblock %}
